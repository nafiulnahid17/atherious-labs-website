{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atherious-labs-app",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
